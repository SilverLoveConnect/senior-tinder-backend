# 데이터베이스
DATABASE_URL=

# JWT 인증
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2

# Solapi SMS
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase (구버전 앱의 네이티브 토큰 발송용 — 현재 앱은 Expo 경유)
# 로컬: 서비스 계정 JSON 파일 경로 / 프로덕션: JSON 전체를 Base64 인코딩한 값(설정 시 PATH보다 우선)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Sentry
SENTRY_DSN=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI 서버 — 비어 있으면 스캠 탐지·사진 검수·자기소개 추천·태그 정규화가 동작하지 않음
AI_API_URL=
AI_IMAGE_API_URL=
# AI 서버·사진 검수가 요구하는 X-API-Key (비어 있으면 헤더를 붙이지 않음)
AI_API_KEY=

# 내부 서비스(AI 서버 등) 콜백 인증 토큰 — 비어 있으면 /internal/* 가 전부 503으로 막힘(사진 검수 결과 반영 안 됨)
INTERNAL_TOKEN=

# 포트원 V1 결제
PORTONE_IMP_KEY=
PORTONE_IMP_SECRET=
# 포인트·구독은 스토어 인앱결제 정책 대상이라 닫아 둔다(config.py 주석 참고). 비워 두면 기동 실패하므로 값을 지울 것
PAYMENTS_ENABLED=false

# 스토어 심사관 검수용 고정 인증코드 (둘 다 설정해야 활성화됨, 비워두면 미사용)
REVIEW_TEST_PHONE=
REVIEW_TEST_CODE=

# CORS 허용 도메인 (콤마 구분, 프로덕션에서만 설정. 비워두면 전체 허용)
CORS_ALLOWED_ORIGINS=
